<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f0f0f0;
        margin: 0;
        padding: 20px;
    }

    form {
        background-color: #fff;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 5px 8px rgba(0, 0, 0, 0.1);
        max-width: 400px;
        margin: auto;
    }

    label {
        display: block;
        margin-bottom: 10px;
        font-weight: bold;
    }

    input {
        width: 100%;
        padding: 8px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    button {
        background-color: gray;
        color: white;
        padding: 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display:block;
        border-radius:15px;
    }

    button:hover {
        background-color:black;
    }
</style>
<isdecorate template="common/layout/page">
    <p>Greeting message!</p>
    <h1>Hello User, Welcome to our Home Page1</h1>
    <form action="https://zydh-006.dx.commercecloud.salesforce.com/on/demandware.store/Sites-RefArch-Site/en-US/Home-AddNumber" method="POST">
        <label for="number">Please enter any number you want:</label>
        <input type="number" id="number" name="number" required>
        <button type="submit">+1</button>
    </form>
</isdecorate>